# --- Rox API ---
ROX_BASE_URL=https://core.roxai.dev/api/v1
ROX_API_TOKEN=
# used as the refresh_by_tab `tab_id` meaning "all accounts".
# leave blank to auto-discover from /priorities.
ROX_ORG_ID=
# create real DRAFT sequences in Rox when an opportunity is accepted
ROX_WRITES_ENABLED=true

# --- LLM (rationale expansion, outreach copy, notification summaries) ---
ANTHROPIC_API_KEY=

# --- App ---
APP_BASE_URL=http://localhost:3000
DATABASE_URL=sqlite+aiosqlite:///./rox_pipeline.db
LOG_LEVEL=INFO

# --- Research cycle ---
RESEARCH_INTERVAL_MINUTES=15
RESEARCH_RUN_ON_STARTUP=false
# trigger regeneration (refresh_by_tab) before reading. Only works for columns
# authored in the Rox UI - API-created columns never generate cells.
RESEARCH_REFRESH_ENABLED=true
# comma-separated Rox column NAMES; overrides the registry in
# app/services/research_columns.py. Unknown names are added as CONTEXT
# (fetched and shown, but never affecting the score).
RESEARCH_COLUMNS=
# ceiling for waiting on CUSTOM_CELL_GENERATION jobs (~90s per cell)
JOB_POLL_TIMEOUT_SECONDS=600
# how long to look for jobs after a refresh before concluding none were scheduled
JOB_DISCOVERY_ATTEMPTS=6
JOB_DISCOVERY_INTERVAL_SECONDS=5.0
JOB_POLL_INTERVAL_SECONDS=10.0
# bound on concurrent per-account cell fetches during a research run
RESEARCH_CONCURRENCY=8

# --- Opportunity generation ---
OPPORTUNITY_SCORE_THRESHOLD=60
OPPORTUNITY_COOLDOWN_DAYS=7
CONTACTS_PER_OPPORTUNITY=3
# only opportunities at/above this score get the LLM rationale expansion
LLM_EXPANSION_SCORE_THRESHOLD=85

# --- Notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=
# opportunities queue until this many are pending, then go out as one email
NOTIFICATION_BATCH_SIZE=5
